# =========================================================
# Swaraksha Web App - Environment Configuration
# =========================================================
# NOTE: ALL variables are 100% OPTIONAL.
# If left unset, the app uses calibrated production fallbacks automatically:
# - Signaling: https://swaraksha-app-36el.onrender.com
# - WebSockets: wss://swaraksha-app-36el.onrender.com
# - Audio Cloud: wss://mybot-02r08nwi.livekit.cloud
# =========================================================

# (Optional) Custom Render / Signaling HTTP Server
VITE_RENDER_HTTP_URL=https://swaraksha-app-36el.onrender.com

# (Optional) Custom Render / Signaling WebSocket Server
VITE_RENDER_WS_URL=wss://swaraksha-app-36el.onrender.com

# (Optional) Custom LiveKit Cloud Server URL
VITE_LIVEKIT_URL=wss://mybot-02r08nwi.livekit.cloud
